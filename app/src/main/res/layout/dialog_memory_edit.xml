<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/memory_path"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/memPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/memory_path_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/memory_name"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/memTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/memory_description"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/memDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/memory_aliases"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/memAliases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/memPinned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/memory_pinned"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/memory_body"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/memBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:hint="@string/memory_body_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="7"
            android:scrollbars="vertical"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/memSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_meta"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>