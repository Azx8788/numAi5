<?xml version="1.0" encoding="utf-8"?>
<!--
  B2 / 步骤20：
  - cleartextTrafficPermitted=true：允许用户填写 http:// 中转地址（targetSdk 28+ 默认禁明文）
  - release 仅信任系统 CA；debug 构建经 debug-overrides 额外信任用户 CA（便于抓包调试）
  - 注意：Android 5.0-7.0 设备连接 Let's Encrypt 站点可能失败
    （ISRG Root X1 自 Android 7.1.1 起才进入系统信任库，README 有说明）
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
